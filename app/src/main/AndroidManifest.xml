<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ClearMovie is offline by design: there is no INTERNET permission.
         The only permissions read the phone's photos and videos, asked for
         once on a plain-language screen (data/media/MediaPermissions.kt).
         Android 13+: images and videos; 14+ also lets the user choose
         "Select photos" (partial access). Android 10-12: READ_EXTERNAL_STORAGE. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- Export (ARCHITECTURE section 12): a foreground worker keeps saving the
         video while the screen turns or the app is in the background, with a
         progress notification and Stop. mediaProcessing is the type on
         Android 15+; dataSync before it. POST_NOTIFICATIONS (Android 13+) is
         asked for once, when the first export starts; saving works without it.
         Writing to Movies/ClearMovie needs no storage permission: the app only
         adds and removes its own entries. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- allowBackup is false: projects (from cm-storage on) hold links to this
         phone's gallery, which mean nothing on another phone, and settings are
         three switches. Nothing is worth an automatic cloud copy.
         dataExtractionRules repeats that for Android 12+ device transfer.
         DataExtractionRules lint asks for fullBackupContent too; with backup
         off on every version there is nothing for it to configure. -->
    <application
        android:name=".ClearMovieApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClearMovie">

        <!-- The only activity. Exported because it is the launcher entry.
             singleTop so a later share (cm-share) reaches onNewIntent instead
             of stacking a second editor. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ClearMovie.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager's foreground service, given the export's types. Not
             exported (WorkManager's own declaration), so no other app can start it. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing"
            tools:node="merge" />

        <!-- The export notification's Stop button. Not exported: only the app's
             own immutable PendingIntent reaches it. -->
        <receiver
            android:name=".work.ExportStopReceiver"
            android:exported="false" />

        <!-- WorkManager starts from ClearMovieApplication (Configuration.Provider)
             with Hilt's worker factory, not from its start-up initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Per-app language on Android 10-12: AppCompat stores the in-app
             choice itself (autoStoreLocales) and applies it on every start.
             On Android 13+ the system's LocaleManager stores it instead. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
