{
  "schemaVersion": 1,
  "id": "event-frame",
  "displayNameRes": "preset_event_frame_name",
  "shape": "landscape",
  "intro": { "slot": "intro", "kind": "video" },
  "ending": { "slot": "ending", "kind": "audio", "visual": "holdLast" },
  "frame": {
    "slot": "frame",
    "keyColor": "#00D922",
    "tolerance": 0.18,
    "softness": 0.08,
    "contentRect": { "x": 0.0094, "y": 0.0222, "w": 0.9813, "h": 0.7741 },
    "startAfterIntro": true,
    "coverEnding": "auto",
    "repeat": true,
    "music": { "enabled": true, "gainDb": -8, "role": "MUSIC" }
  },
  "caption": {
    "box": { "x": 0.15, "y": 0.7981, "w": 0.83, "h": 0.1222 },
    "align": "center",
    "font": "noto_sans_devanagari_bold",
    "sizePx": 60,
    "color": "#FFFFFF",
    "outline": null,
    "background": null,
    "defaultText": { "hi": "सुंदर प्रकृति" }
  },
  "photoDurationMs": 3000,
  "defaultFit": "fillCrop",
  "effects": { "photoDuring": "gentleZoomIn", "mainTransition": "crossfade", "transitionMs": 600, "textStart": "fadeIn" },
  "ducking": { "musicUnderClipDb": -12, "musicUnderVoiceDb": -20, "speechDuckDb": -20, "attackMs": 300, "releaseMs": 300 },
  "export": { "height": 1080, "fps": 30, "videoCodec": "h264", "audioSampleRate": 48000, "audioBitrate": 192000 }
}
