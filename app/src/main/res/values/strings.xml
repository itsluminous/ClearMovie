<?xml version="1.0" encoding="utf-8"?>
<!-- Every string the user sees in the app. Translations live in values-hi/
     (Hindi) and values-b+hi+Latn/ (Hinglish) with exactly the same names and
     placeholders; StringKeyParityTest and Lint's MissingTranslation /
     ExtraTranslation checks fail the build otherwise. Never build a sentence
     by joining strings in code: use placeholders (%1$s) and <plurals>. -->
<resources>
    <string name="action_settings">Settings</string>
    <string name="action_back">Back</string>

    <string name="home_empty_title">Your videos will appear here</string>
    <string name="home_empty_body">Making videos arrives in an update soon. You can already choose the theme and language in Settings.</string>
    <plurals name="home_saved_videos">
        <item quantity="one">%1$d saved video</item>
        <item quantity="other">%1$d saved videos</item>
    </plurals>

    <string name="settings_title">Settings</string>
    <string name="settings_section_theme">Theme</string>
    <string name="theme_system">Same as phone</string>
    <string name="theme_light">Light</string>
    <string name="theme_dark">Dark</string>
    <string name="settings_dynamic_color">Colours from wallpaper</string>
    <string name="settings_dynamic_color_summary">Use the colours of your wallpaper</string>
    <string name="settings_dynamic_color_unavailable">Needs Android 12 or newer</string>

    <string name="settings_section_language">Language</string>
    <string name="language_system">Phone language</string>
    <!-- The name of THIS file's language, in its own script. Settings shows
         every language by the value from its own folder. -->
    <string name="language_name_native">English</string>

    <string name="settings_section_about">About</string>
    <!-- %1$s is the version number, for example 0.1.0. -->
    <string name="settings_version">Version %1$s</string>
</resources>
