<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ ignores allowBackup="false" for device-to-device transfer, so
     both cloud backup and transfer exclude everything explicitly (see the
     comment on <application> in AndroidManifest.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
